# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored - never commit real credentials.
#
# The client follows the public DXtrade spec but has not been verified against a
# live broker. Use a DEMO account. FTMO disabled DXtrade REST access for clients
# in April 2024, so no values below will work against FTMO.

# Base URL of your broker's DXtrade deployment (no trailing slash).
DXTRADE_BASE_URL=https://dxtrade.your-broker.com

# Credentials. The password is never logged by the client.
DXTRADE_USERNAME=
DXTRADE_PASSWORD=

# Your DXtrade domain, sent with the credentials (usually "default").
DXTRADE_DOMAIN_VENDOR=default

# REST prefix; "/dxsca-web" per the DXtrade REST spec.
DXTRADE_API_PREFIX=/dxsca-web

# Account code in "clearing:account" form, e.g. default:ACC12345. Optional: if
# empty it is looked up via GET /users/{username}; required if you have several.
DXTRADE_ACCOUNT=

# Push API websocket URL. The spec leaves this to each deployment - ask your
# broker. Leave empty to skip streaming in example.py.
DXTRADE_WEBSOCKET_URL=

# Symbols example.py streams quotes for.
DXTRADE_SYMBOLS=EUR/USD,GBP/USD
